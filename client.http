@kong = http://localhost:8000
@authDirect = http://localhost:5001
@notesDirect = http://localhost:8082

### ============ AUTH SERVICE ============

### Sign up
POST {{authDirect}}/api/auth/sign-up/email
Content-Type: application/json
Origin: {{authDirect}}

{
  "email": "test@synapse.com",
  "password": "12345678",
  "name": "Test User"
}

### Login (email/password)
# @name login
POST {{authDirect}}/api/auth/sign-in/email
Content-Type: application/json
Origin: {{authDirect}}

{
  "email": "test@synapse.com",
  "password": "12345678"
}

### Lấy JWT token (dùng session cookie ở trên, hoặc gọi /token nếu dùng JWT plugin)
# @name getToken
GET {{authDirect}}/api/auth/token
Authorization: Bearer {{login.response.body.token}}
Origin: {{authDirect}}

### Xem JWKS (public keys để verify JWT)
GET {{authDirect}}/api/auth/jwks

### Get session hiện tại
GET {{authDirect}}/api/auth/get-session
Cookie: better-auth.session_token={{login.response.headers.set-cookie}}
Origin: {{authDirect}}


### ============ NOTES SERVICE (direct, chưa qua Kong) ============

# @name createNote
POST {{notesDirect}}/api/notes
Content-Type: application/json
Authorization: Bearer {{getToken.response.body.token}}

{
  "title": "Note đầu tiên",
  "content": "Nội dung test note để verify pgvector sau này"
}

### Lấy danh sách note theo userId
GET {{notesDirect}}/api/notes
Authorization: Bearer {{getToken.response.body.token}}

### Lấy 1 note theo id
GET {{notesDirect}}/api/notes/{{createNote.response.body.data.id}}
Authorization: Bearer {{getToken.response.body.token}}

### Update note
PUT {{notesDirect}}/api/notes/{{createNote.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{getToken.response.body.token}}

{
  "title": "Note đã sửa",
  "content": "Nội dung mới"
}

### Xoá note
DELETE {{notesDirect}}/api/notes/{{createNote.response.body.data.id}}
Authorization: Bearer {{getToken.response.body.token}}


### ============ QUA KONG GATEWAY (test full path) ============

### Login qua Kong
# @name loginViaKong
POST {{kong}}/api/auth/sign-in/email
Content-Type: application/json
Origin: {{kong}}

{
  "email": "test@synapse.com",
  "password": "12345678"
}

### 
# @name getTokenViaKong
GET {{kong}}/api/auth/token
Authorization: Bearer {{getTokenViaKong.response.body.token}}
Origin: {{kong}}

### Tạo note qua Kong
POST {{kong}}/api/notes
Content-Type: application/json
Authorization: Bearer {{getTokenViaKong.response.body.token}}

{
  "title": "Note qua Kong",
  "content": "Test route qua gateway"
}

### Danh sách note qua Kong
GET {{kong}}/api/notes
Authorization: Bearer {{getTokenViaKong.response.body.token}}


### ============ HEALTH CHECKS ============

### Notes actuator health
GET {{notesDirect}}/actuator/health

### Kong admin — xem service đã load
GET http://localhost:8001/services