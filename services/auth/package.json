{
  "name": "synapse-auth",
  "version": "0.1.12",
  "private": true,
  "description": "AI-native personal knowledge assistant with RAG-powered note chat and agentic reminders",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "build": "bun build --production --outdir=dist --minify --target=node src/index.ts",
    "auth:gen:schema": "bunx --bun auth@latest generate --config src/auth/service.ts --output src/database/schema.ts --yes",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint && eslint --cache .",
    "lint:fix": "oxlint --fix && eslint --cache --fix .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/eslint-config": "^2.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "glob": "^13.0.6",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "**/*": [
      "bun --bun format",
      "bun --bun lint:fix"
    ]
  }
}
