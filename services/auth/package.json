{
	"name": "auth",
	"lint-staged": {
		"*": "bun --bun check"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun run --hot src/index.ts",
		"build": "bun build --production --outdir=dist --minify --target=node src/index.ts",
		"generate-auth-schema": "bun x --bun auth generate --config src/auth/service.ts --output src/database/schema.ts --yes",
		"lint": "oxlint . && eslint .",
		"format": "prettier --list-different --write .",
		"check": "prettier --list-different --write . && oxlint --fix . && eslint --fix .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"prepare": "husky"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.1",
		"@neondatabase/serverless": "^1.1.0",
		"@t3-oss/env-core": "^0.13.11",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.4",
		"http-status-codes": "^2.3.0",
		"pg": "^8.23.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hono/eslint-config": "^2.1.1",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "latest",
		"@types/node": "^26.3.0",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "^1.80.0",
		"eslint-plugin-perfectionist": "^5.10.1",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxlint": "^1.80.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.68.0"
	}
}
