{
	"name": "auth",
	"lint-staged": {
		"*": "bun --bun check"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun run --port 5002 --hot src/app.ts",
		"build": "bun build --production --outdir=dist --minify --target=node src/app.ts",
		"lint": "oxlint . && eslint .",
		"format": "prettier --list-different --write .",
		"check": "prettier --list-different --write . && oxlint --fix . && eslint --fix .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"prepare": "husky"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.31",
		"@hono/zod-validator": "^0.9.0",
		"@t3-oss/env-core": "^0.13.11",
		"ai": "^7.0.47",
		"drizzle-orm": "^1.0.0-rc.4",
		"hono": "^4.12.33",
		"http-status-codes": "^2.3.0",
		"jose": "^6.2.6",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hono/eslint-config": "^2.1.1",
		"@types/bun": "latest",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.3",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "^1.76.0",
		"eslint-plugin-perfectionist": "^5.10.0",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxlint": "^1.76.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.65.0"
	}
}
