{
  "vhosts": [{ "name": "synapse-vhost" }],
  "users": [
    {
      "name": "admin_user",
      "password_hash": "HASH_CHO_ADMIN",
      "tags": "administrator"
    },
    {
      "name": "notes_user",
      "password_hash": "HASH_CHO_NOTES",
      "tags": ""
    },
    {
      "name": "ai_user",
      "password_hash": "HASH_CHO_AI",
      "tags": ""
    }
  ],
  "permissions": [
    {
      "user": "admin_user",
      "vhost": "synapse-vhost",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "notes_user",
      "vhost": "synapse-vhost",
      "configure": "^note\\..*",
      "write": "^note\\..*",
      "read": "^note\\..*"
    },
    {
      "user": "ai_user",
      "vhost": "synapse-vhost",
      "configure": "^note\\..*",
      "write": "^(note\\..*|amq\\.default)$",
      "read": "^note\\..*"
    }
  ]
}