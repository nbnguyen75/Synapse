    "generate-routes": "tsr generate",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "oxfmt --ignore-path=.gitignore --ignore-path=.oxlintignore",
    "lint": "oxlint --ignore-path .oxlintignore . && eslint --cache .",
