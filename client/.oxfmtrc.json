{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "singleQuote": true,
  "tabWidth": 2,
  "semi": true,
  "printWidth": 80,
  "sortImports": {
    "customGroups": [
      {
        "elementNamePattern": ["react", "react/**", "react-dom/**", "react-*"],
        "groupName": "react",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@tanstack/**"],
        "groupName": "tanstack",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@radix-ui/**", "@base-ui/**"],
        "groupName": "lib-ui",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["ai", "@ai-sdk/**"],
        "groupName": "ai-libs",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/routes/**", "**/routeTree.gen*"],
        "groupName": "routes",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/layouts/**"],
        "groupName": "layouts",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/features/**"],
        "groupName": "modules",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/hooks/**"],
        "groupName": "hooks",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/store/**"],
        "groupName": "store",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/providers", "@/providers/**"],
        "groupName": "providers",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/config/**"],
        "groupName": "config",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/lib/**", "@/paraglide/**", "./paraglide/**"],
        "groupName": "libs",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/components/ai-elements/**"],
        "groupName": "ai-elements",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/components/ui/**"],
        "groupName": "shadcn",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/components/**"],
        "groupName": "components",
        "modifiers": ["value"]
      },
      {
        "elementNamePattern": ["@/assets/**", "lucide-react", "@iconify/react"],
        "groupName": "assets",
        "modifiers": ["value"]
      }
    ],
    "groups": [
      "type",
      "builtin",
      "react",
      "tanstack",
      "external",
      "lib-ui",
      "ai-libs",
      "routes",
      "layouts",
      "modules",
      "hooks",
      "store",
      "providers",
      "config",
      "libs",
      "components",
      "ai-elements",
      "shadcn",
      "parent",
      "sibling",
      "index",
      "assets",
      "side_effect_style",
      "style",
      "import"
    ],
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "LICENSE",
    ".output",
    ".vercel",
    "src/routeTree.gen.ts",
    "src/paraglide/**",
    "project.inlang/**",
    "!project.inlang/settings.json",
    ".agents/**/scripts",
    ".claude/**/scripts",
    "AGENTS.md",
    "feature_list.json",
    "init.sh",
    "progress.md",
    "session-handoff.md",
    ".env*",
    ".gitignore",
    ".vscode",
    ".dockerignore",
    "docs",
    "**/routeTree.gen.ts",
    "**/deprecated"
  ]
}
